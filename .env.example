# Keel — AI assistant (optional)
#
# By default every user pastes their own Anthropic API key in Settings → AI
# assistant. It lives in that browser's localStorage only, is sent with each
# request in the x-keel-api-key header, and is never stored or logged by the
# server. Nothing else in Keel needs environment variables.
#
# Self-hosters can instead provide one key for everyone who can reach the
# instance. BOTH variables are required: the key alone is ignored, so a public
# deployment cannot spend the operator's credits by accident.
# Never set KEEL_ALLOW_SERVER_KEY=true on a publicly reachable instance.
ANTHROPIC_API_KEY=
KEEL_ALLOW_SERVER_KEY=false

# Local folder bridge (only honoured for requests from localhost).
# Markdown under <dir>/vault becomes notes, JSON bundles under <dir>/import merge
# projects/issues/decisions/risks, and <dir>/backups is a good target for
# automatic backups. Leave unset on a hosted deployment.
KEEL_LOCAL_DIR=~/Keel
